// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HPIOptimizationPanel > explains an empty result the same 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><div style="margin-top: 1rem; color: rgb(100, 116, 139);"><p>No heat pump can be integrated with this stream selection.</p><p style="margin-top: 0.5rem;">7 of 1773 operating points are source-limited: the heat pump covers only part of the demand above T_sink because the available waste heat runs out.</p><p style="margin-top: 0.5rem;">23 of 1773 operating points are demand-limited: they cover the full demand above T_sink but leave waste heat unused at T_source, so they sit off the source profile. They are hidden from the chart unless switched on.</p></div><p style="margin-top: 1rem; font-size: 0.85rem; color: rgb(100, 116, 139);">Click on any column header to sort. Click on any point in the chart to inspect its details and add it to the table.</p></div></div><div class="pa-right-col"><div class="pa-card pa-opt-row" style="gap: 1.5rem; align-items: flex-start;"><div class="pa-opt-filters" style="gap: 1rem; background: rgb(248, 250, 252); padding: 1rem; border-radius: 8px; border: 1px solid rgb(226, 232, 240);"><div><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">MEDIUM SINK</label><select style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; width: 100%;"><option value="All">All</option></select></div><div><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">REFRIGERANT TYPE</label><select style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; width: 100%;"><option value="All">All</option></select></div><div style="position: relative;"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">REFRIGERANT</label><div style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">All</span><span style="font-size: 0.8em; margin-left: 8px;">▼</span></div></div><div style="position: relative;"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">NR. COMPRESSORS</label><div style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; width: 100%;"><span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">All</span><span style="font-size: 0.8em; margin-left: 8px;">▼</span></div></div><div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem;"><button style="padding: 0.4rem 0.8rem; background: rgb(37, 99, 235); color: rgb(255, 255, 255); border: medium; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.85rem; width: 100%;">Select All</button><button style="padding: 0.4rem 0.8rem; background: rgb(220, 38, 38); color: rgb(255, 255, 255); border: medium; border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 0.85rem; width: 100%;">Clear Selection</button><p style="margin-top: 0.5rem; font-size: 0.8rem; color: rgb(100, 116, 139); text-align: center; font-weight: 500;">Feasible Combinations: 0</p></div><div><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">COP MODEL</label><select style="padding: 0.4rem; border-radius: 4px; border: 1px solid rgb(203, 213, 225); background: rgb(255, 255, 255); color: rgb(15, 23, 42); min-width: 150px;" title="2 temps: source return and sink supply. 4 temps: also source supply and sink return, both taken from the pinch (pinch − ΔTmin/2 and pinch + ΔTmin/2)."><option value="2t">Model 2 temps</option><option value="4t">Model 4 temps</option></select></div><div class="cf-trigger-block"><div class="cf-trigger-head"><label style="font-size: 0.85rem; color: rgb(100, 116, 139); display: block; margin-bottom: 0.25rem; font-weight: 500;">COP SOURCE</label><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div><button class="cf-trigger ">ƒ Use my own COP formula<span class="cf-trigger-sub">Paste a custom COP to perform integration and optimization with your own heat pump.</span></button></div></div><div class="pa-opt-chart" style="display: flex; min-width: 0px; overflow: hidden;"><div data-testid="chart">{"points":"0:1505","maxQ":null,"selected":[],"pinch":73,"mode":"net_load"}<button data-testid="chart-pick"></button></div></div></div></div></div></div>"`;

exports[`HPIOptimizationPanel > renders German the same 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><div class="pa-hp-section-label" style="display: flex; align-items: center; gap: 0.5rem; position: sticky; top: 0px; background: rgb(255, 255, 255); z-index: 2; margin: 0px; padding-bottom: 0.5rem; color: rgb(37, 99, 235); font-weight: 600;">Integration mit Wärmepumpenmodell und Optimierung<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div><table class="pa-table pa-hp-table"><thead style="position: sticky; top: 30px; z-index: 2;"><tr><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap; min-width: 190px;"><div style="display: flex; align-items: center; gap: 0.25rem;">TYP<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap; width: 1%;"><div style="display: flex; align-items: center; gap: 0.25rem;">KÄLTEM.<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">MEDIUM SENKE<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;"><span class="notranslate">COP</span><span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Q_SENKE (KW)<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span><span style="margin-left: 4px; font-size: 1em; opacity: 1;">↓</span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Q_QUELLE (KW)<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">P_EL (KW)<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Actual Sink Temp [°C]<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Shifted Sink (T+5K) [°C]<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Actual Source Temp [°C]<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">Shifted Source (T−5K) [°C]<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">KÄLTEMITTEL<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;"><div style="display: flex; align-items: center; gap: 0.25rem;">ANZ. VERDICHTER<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;">VORLAUF QUELLE (°C)</th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap;">RÜCKLAUF SENKE (°C)</th></tr></thead><tbody><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(209, 250, 229); color: rgb(6, 95, 70);" title="Die Carnot-Beziehung zwischen den beiden Temperaturen mit einem Gütegrad von 50 % als Faustregel für eine erreichbare Wärmepumpe. Keine Maschine und keine angepasste Korrelation, daher kann eine reale Maschine über dieser Linie liegen.">Theoretisch</span><span style="font-size: 0.75rem; color: rgb(100, 116, 139);">Carnot (50 %)</span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div></td><td></td><td></td><td style="background-color: rgba(124, 58, 237, 0.13); font-weight: 600;">4.76</td><td style="background-color: rgba(143, 174, 224, 0.2);">375.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">296.3</td><td style="background-color: rgba(95, 174, 140, 0.18);">78.7</td><td style="background-color: rgba(143, 174, 224, 0.2);">108.0</td><td style="background-color: rgba(143, 174, 224, 0.2);">113.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">63.2</td><td style="background-color: rgba(232, 139, 139, 0.2);">58.2</td><td></td><td></td><td style="background-color: rgba(232, 139, 139, 0.2);">–</td><td style="background-color: rgba(143, 174, 224, 0.2);">–</td></tr><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(219, 234, 254); color: rgb(30, 58, 138);" title="Eine Regression über Simulationsdaten von Wärmepumpen aus einer Parameterstudie eines Herstellers (verschiedene Kältemittel, Senkenmedien und Verdichterstufen), ausgewertet bei den Temperaturen dieses Punktes.">Real</span><span style="font-size: 0.75rem; color: rgb(100, 116, 139);"></span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div></td><td>Custom formula</td><td>Custom</td><td style="background-color: rgba(124, 58, 237, 0.13); font-weight: 600;">1.28</td><td style="background-color: rgba(143, 174, 224, 0.2);">375.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">82.2</td><td style="background-color: rgba(95, 174, 140, 0.18);">292.8</td><td style="background-color: rgba(143, 174, 224, 0.2);">108.0</td><td style="background-color: rgba(143, 174, 224, 0.2);">113.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">73.9</td><td style="background-color: rgba(232, 139, 139, 0.2);">68.9</td><td>Test</td><td>1</td><td style="background-color: rgba(232, 139, 139, 0.2);">–</td><td style="background-color: rgba(143, 174, 224, 0.2);">–</td></tr><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(219, 234, 254); color: rgb(30, 58, 138);" title="Eine Regression über Simulationsdaten von Wärmepumpen aus einer Parameterstudie eines Herstellers (verschiedene Kältemittel, Senkenmedien und Verdichterstufen), ausgewertet bei den Temperaturen dieses Punktes.">Real</span><span style="font-size: 0.75rem; color: rgb(100, 116, 139);"></span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div></td><td>Synthetic</td><td>Steam</td><td style="background-color: rgba(124, 58, 237, 0.13); font-weight: 600;">3.37</td><td style="background-color: rgba(143, 174, 224, 0.2);" title="Quellenbegrenzt: Die verfügbare Abwärme deckt nur 99 % der 375.0 kW, die oberhalb dieser Senkentemperatur benötigt werden.">369.7<span style="color: rgb(180, 83, 9); margin-left: 0.25rem;">* / 375.0</span></td><td style="background-color: rgba(232, 139, 139, 0.2);">260.0</td><td style="background-color: rgba(95, 174, 140, 0.18);">109.7</td><td style="background-color: rgba(143, 174, 224, 0.2);">108.0</td><td style="background-color: rgba(143, 174, 224, 0.2);">113.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">65.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">60.0</td><td>R1336mzzZ</td><td>1</td><td style="background-color: rgba(232, 139, 139, 0.2);">–</td><td style="background-color: rgba(143, 174, 224, 0.2);">–</td></tr><tr><td><div style="display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;"><span style="display: inline-block; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; background-color: rgb(219, 234, 254); color: rgb(30, 58, 138);" title="Eine Regression über Simulationsdaten von Wärmepumpen aus einer Parameterstudie eines Herstellers (verschiedene Kältemittel, Senkenmedien und Verdichterstufen), ausgewertet bei den Temperaturen dieses Punktes.">Real</span><span style="font-size: 0.75rem; color: rgb(100, 116, 139);"></span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Erklärung anzeigen"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></div></td><td>Natural</td><td>Steam</td><td style="background-color: rgba(124, 58, 237, 0.13); font-weight: 600;">4.13</td><td style="background-color: rgba(143, 174, 224, 0.2);">345.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">261.4</td><td style="background-color: rgba(95, 174, 140, 0.18);">83.6</td><td style="background-color: rgba(143, 174, 224, 0.2);">106.0</td><td style="background-color: rgba(143, 174, 224, 0.2);">111.0</td><td style="background-color: rgba(232, 139, 139, 0.2);">64.9</td><td style="background-color: rgba(232, 139, 139, 0.2);">59.9</td><td>Butane</td><td>3</td><td style="background-color: rgba(232, 139, 139, 0.2);">–</td><td style="background-color: rgba(143, 174, 224, 0.2);">–</td></tr></tbody></table><p style="margin-top: 0.75rem; font-size: 0.85rem; color: rgb(180, 83, 9);">* Source-limited: the available waste heat covers only part of the demand above T_sink. The second figure is the full requirement; the rest still has to come from a utility.</p><p style="margin-top: 1rem; font-size: 0.85rem; color: rgb(100, 116, 139);">Klicken Sie zum Sortieren auf eine Spaltenüberschrift. Klicken Sie auf einen Punkt im Diagramm, um Details anzuzeigen und ihn der Tabelle hinzuzufügen.</p></div></div><div class="pa-right-col"><div class="pa-ca