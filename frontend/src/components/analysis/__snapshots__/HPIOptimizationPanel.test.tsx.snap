exports[`HPIOptimizationPanel > renders the same for every control > optimization.panel.filters.hp_stages_open 1`] = `"<div class="analysis-panel " style="margin-top: 2rem;"><div class="pa-split-layout"><div class="pa-left-col"><div class="pa-hp-table-wrap" style="max-height: 440px; overflow-y: auto;"><div class="pa-hp-section-label" style="display: flex; align-items: center; gap: 0.5rem; position: sticky; top: 0px; background: rgb(255, 255, 255); z-index: 2; margin: 0px; padding-bottom: 0.5rem; color: rgb(37, 99, 235); font-weight: 600;">Integration with Heat Pump model and optimization<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div><table class="pa-table pa-hp-table"><thead style="position: sticky; top: 30px; z-index: 2;"><tr><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap; min-width: 190px;"><div style="display: flex; align-items: center; gap: 0.25rem;">TYPE<span><div class="chart-help-container inline"><button class="btn btn-sm chart-help-btn  " title="Show explanation"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button></div></span></div></th><th style="cursor: pointer; user-select: none; position: sticky; top: 0px; z-index: 1; white-space: nowrap; width: 1%;"><div style="display: flex; align-items: center; g