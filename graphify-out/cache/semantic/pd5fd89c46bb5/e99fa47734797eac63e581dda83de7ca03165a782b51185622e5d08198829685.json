{"nodes": [{"id": "docs_pinch_analysis_pinch_analysis", "label": "Pinch Analysis", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foundational calculation: determines minimum heating/cooling utility, pinch temperature, and the diagnostic curves that drive all downstream modules. Follows Linnhoff & Hindmarsh (1983), extended for multi-process industrial edge cases."}, {"id": "docs_pinch_analysis_linnhoff_hindmarsh_1983", "label": "Linnhoff & Hindmarsh (1983)", "file_type": "paper", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pinch_analysis_process_stream", "label": "Process Stream (CP, Ts, Tt)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stream is fully described by heat capacity flow rate, supply and target temperature; hot/cold classification is derived automatically from Ts vs Tt rather than asked of the user."}, {"id": "docs_pinch_analysis_temperature_shifting", "label": "Temperature Shifting by DTmin/2", "file_type": "rationale", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hot streams are shifted down and cold streams up by DTmin/2 so that equal shifted temperatures imply exactly DTmin of real separation. This guarantees feasible heat exchange globally without pairwise checking of every hot/cold stream combination."}, {"id": "docs_pinch_analysis_temperature_intervals", "label": "Temperature Intervals", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pinch_analysis_problem_table", "label": "Problem Table (deltaT, deltaCP, deltaH)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sign convention chosen so deltaH>0 means net heat surplus (hot dominates) and deltaH<0 net deficit, making the cascade arithmetic a simple running sum."}, {"id": "docs_pinch_analysis_heat_cascade", "label": "Heat Cascade (two-pass, feasible and unfeasible)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pass 1 cascades from zero and may go negative (thermodynamically infeasible); the most negative value gives the minimum hot utility. Pass 2 re-cascades starting at Q_H,min so all exit enthalpies are non-negative, and the zero-crossing interval bottom is the pinch temperature."}, {"id": "docs_pinch_analysis_pinch_temperature", "label": "Pinch Temperature", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temperature where zero heat crosses; divides the problem into above-pinch (net heating) and below-pinch (net cooling), which is what lets a heat pump be placed meaningfully."}, {"id": "docs_pinch_analysis_minimum_utilities", "label": "Minimum Hot and Cold Utility", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pinch_analysis_shifted_composite_diagram", "label": "Shifted Composite Diagram", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hot composite accumulates from the cold end at H=0; cold composite accumulates from the hot end starting at total cold enthalpy plus cold utility. Flat end segments where no streams are active are trimmed to produce clean curves."}, {"id": "docs_pinch_analysis_composite_diagram", "label": "Composite Diagram (actual temperatures)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Obtained purely by un-shifting the temperature axis of the shifted diagram; enthalpies are untouched, so the horizontal gap at the pinch equals exactly DTmin."}, {"id": "docs_pinch_analysis_grand_composite_curve", "label": "Grand Composite Curve (GCC)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plots the feasible cascade exit enthalpies against shifted temperature; runs from (Q_H,min, T_max) to (Q_C,min, T_min) and touches zero at the pinch. Chosen as the single shared input for heat pump integration, pocket deletion, and total site profiles."}, {"id": "docs_pinch_analysis_temperature_pocket_deletion", "label": "Temperature Pocket Deletion", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pockets are heat exchangeable internally within the process, so they must not be charged to external utility or offered to a heat pump. They are removed by linear interpolation in three cases (deficit smaller than surplus, surplus smaller than deficit, exact cancellation), restarting the walk from the pinch after each deletion."}, {"id": "docs_pinch_analysis_pinch_pipeline", "label": "Pinch Analysis Pipeline (solve_pinch sequence)", "file_type": "concept", "source_file": "docs/pinch_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_pinch_analysis_pinch_analysis", "target": "docs_pinch_analysis_linnhoff_hindmarsh_1983", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": null, "weight": 1.0}, {"source": "docs_pinch_analysis_pinch_analysis", "target": "docs_pinch_analysis_process_stream", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": null, "weight": 1.0}, {"source": "docs_pinch_analysis_temperature_shifting", "target": "docs_pinch_analysis_temperature_intervals", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": "Step 1", "weight": 1.0}, {"source": "docs_pinch_analysis_temperature_intervals", "target": "docs_pinch_analysis_problem_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": "Step 3", "weight": 1.0}, {"source": "docs_pinch_analysis_problem_table", "target": "docs_pinch_analysis_heat_cascade", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": "Step 4", "weight": 1.0}, {"source": "docs_pinch_analysis_heat_cascade", "target": "docs_pinch_analysis_pinch_temperature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": "Step 4", "weight": 1.0}, {"source": "docs_pinch_analysis_heat_cascade", "target": "docs_pinch_analysis_minimum_utilities", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/pinch_analysis.md", "source_location": "Step 4", "weight": 1.0}, {"source": "docs_pinch_analysis_heat_cascade", "target": "docs_pinch_