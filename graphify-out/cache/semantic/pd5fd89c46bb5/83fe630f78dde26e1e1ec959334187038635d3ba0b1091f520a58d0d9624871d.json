{"nodes": [{"id": "docs_heat_pump_integration_heat_pump_integration", "label": "Heat Pump Integration (Classic Method)", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determines the heat pump operating point on the GCC: source extraction temperature, deliverable condenser duty, and resulting COP. Offers both a best-available mode (highest COP across technologies at each point) and a technology-specific mode across one technology's full window."}, {"id": "docs_heat_pump_integration_hp_operating_windows", "label": "HP Operating Windows (T_sink and lift envelopes)", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each technology has hard sink-temperature and temperature-lift limits taken from manufacturer data, so candidates must be filtered by envelope before their COP correlation is trusted."}, {"id": "docs_heat_pump_integration_prototypical_regressions", "label": "Prototypical Heat Pump COP Regressions", "file_type": "rationale", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COP models are empirical regressions fitted to manufacturer performance datasets and literature models rather than theoretical thermodynamic correlations, so each curve represents a real machine architecture and refrigerant class within its stated range. Form: COP = a*(dT+2c)^b*(T_sink+273+c)^d."}, {"id": "docs_heat_pump_integration_prototypical_stirling", "label": "Prototypical Stirling Heat Pump", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_integration_vhthp_hfc_hfo", "label": "VHTHP (HFC/HFO) Very High Temperature Heat Pump", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_integration_shp_hthp_hfc_hfo", "label": "SHP and HTHPs (HFC/HFO)", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_integration_shp_hthp_r717", "label": "SHP and HTHPs (R717 Ammonia)", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_integration_carnot_fallback", "label": "Carnot Fallback COP (50% efficiency)", "file_type": "rationale", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When no named technology can operate at a point, a generic Carnot COP at 50% exergetic efficiency is returned. It is explicitly not a real machine, only an upper bound for comparison, so results outside real envelopes stay interpretable instead of missing."}, {"id": "docs_heat_pump_integration_shifted_temperature_lift", "label": "Shifted Temperatures Encode Physical Lift", "file_type": "rationale", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because hot and cold GCC temperatures are shifted in opposite directions by DTmin/2, T_sink - T_source already equals the true physical lift T_cold - T_hot + DTmin. No extra DTmin penalty is applied in the COP calculation, since it is mathematically built into the curve. Double-penalizing here is a common modelling error this design avoids."}, {"id": "docs_heat_pump_integration_cop_cap", "label": "COP Cap at 15.0", "file_type": "rationale", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "As temperature lift approaches zero the regression and Carnot formulas diverge to unphysical values, so the final COP is hard-capped at 15.0."}, {"id": "docs_heat_pump_integration_best_available_cop_selection", "label": "Best-Available COP Selection", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute lift, filter technologies whose operating window contains the point, evaluate each correlation, take the maximum; fall back to Carnot only when the candidate set is empty."}, {"id": "docs_heat_pump_integration_source_sink_profiles", "label": "Source and Sink Profiles", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Below-pinch heat becomes the evaporator source profile and above-pinch demand the condenser sink profile, so the heat pump is always pumping across the pinch."}, {"id": "docs_heat_pump_integration_heat_recovery_modes", "label": "Heat Recovery Modes (with / without recovery)", "file_type": "rationale", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two bracketing assumptions are offered instead of one: full 100% internal recovery (default, pockets deleted, heat pump sees only residual utility demand) and zero recovery (raw composite curves, every stream duty routed through the heat pump). The pair bounds the real plant, where partial recovery already exists."}, {"id": "docs_heat_pump_integration_integration_walk", "label": "Integration Walk (operating point search)", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps downward in temperature from the hottest source point, interpolating evaporator duty, evaluating COP, and deriving condenser duty from the first law Q_ko = Q_ev*(1-1/COP)^-1. Near convergence the step size is divided by 200 for precision rather than using a solver, keeping the walk monotonic and debuggable."}, {"id": "docs_heat_pump_integration_iterative_sink_temperature", "label": "Iterative Sink Temperature Mode", "file_type": "concept", "source_file": "docs/heat_pump_integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the user gives no sink temperature, the system starts at the top of the sink profile, computes condenser duty, reads back the corresponding sink temperature, and repeats until it converges within 1 degree C."}], "edges": [{"source": "docs_heat_pump_integration_heat_pump_integration", "target": "docs_heat_pump_integration_hp_operating_windows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_prototypical_regressions", "target": "docs_heat_pump_integration_heat_pump_integration", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_prototypical_regressions", "target": "docs_heat_pump_integration_prototypical_stirling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_prototypical_regressions", "target": "docs_heat_pump_integration_vhthp_hfc_hfo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_prototypical_regressions", "target": "docs_heat_pump_integration_shp_hthp_hfc_hfo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_prototypical_regressions", "target": "docs_heat_pump_integration_shp_hthp_r717", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_best_available_cop_selection", "target": "docs_heat_pump_integration_hp_operating_windows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_best_available_cop_selection", "target": "docs_heat_pump_integration_carnot_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_cop_cap", "target": "docs_heat_pump_integration_best_available_cop_selection", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_shifted_temperature_lift", "target": "docs_heat_pump_integration_prototypical_regressions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_shifted_temperature_lift", "target": "docs_pinch_analysis_temperature_shifting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_source_sink_profiles", "target": "docs_pinch_analysis_grand_composite_curve", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_heat_recovery_modes", "target": "docs_heat_pump_integration_source_sink_profiles", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_heat_recovery_modes", "target": "docs_pinch_analysis_temperature_pocket_deletion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_integration_walk", "target": "docs_heat_pump_integration_source_sink_profiles", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_integration_walk", "target": "docs_heat_pump_integration_best_available_cop_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_integration_iterative_sink_temperature", "target": "docs_heat_pump_integration_integration_walk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "heat_pump_cop_model_family", "label": "Prototypical Heat Pump COP Model Family", "nodes": ["docs_heat_pump_integration_prototypical_stirling", "docs_heat_pump_integration_vhthp_hfc_hfo", "docs_heat_pump_integration_shp_hthp_hfc_hfo", "docs_heat_pump_integration_shp_hthp_r717", "docs_heat_pump_integration_carnot_fallback"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_integration.md"}]}