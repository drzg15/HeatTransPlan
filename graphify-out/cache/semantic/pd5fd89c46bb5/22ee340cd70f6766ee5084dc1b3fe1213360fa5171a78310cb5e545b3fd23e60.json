{"nodes": [{"id": "docs_heat_pump_optimization_heat_pump_optimization", "label": "Heat Pump Optimization (ML model and grid search)", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where classic integration uses a handful of prototypical regressions, optimization sweeps a broad spectrum of refrigerants and multi-stage designs using a trained ML regressor or custom COP expressions, evaluated over a 2D mesh of source/sink temperatures to find exact thermal matching conditions."}, {"id": "docs_heat_pump_optimization_predictive_ml_cop_model", "label": "Predictive ML COP Model (joblib regressor)", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Scikit-Learn regressor persisted via joblib predicts COP from source return temperature, sink supply temperature, sink medium, and refrigerant stage count, which scales to many refrigerants without hand-fitting a correlation per fluid."}, {"id": "docs_heat_pump_optimization_refrigerant_data_schema", "label": "Refrigerant Alternative Schema (cop_ranges.json)", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_optimization_temperature_approach_corrections", "label": "Evaporator/Condenser Approach Corrections", "file_type": "rationale", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process temperatures are corrected before prediction (source minus deltaT_evap, sink plus deltaT_cond, typically 5 K each) because the refrigerant, not the process fluid, sets the achievable COP across a real heat exchanger."}, {"id": "docs_heat_pump_optimization_custom_cop_formula", "label": "Custom COP Formula (safe AST evaluation)", "file_type": "rationale", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users may supply their own COP expression in T_src, T_sink and dT. It is parsed to an AST and validated to contain only safe arithmetic nodes before compilation, so user input cannot execute arbitrary code."}, {"id": "docs_heat_pump_optimization_mesh_grid_search", "label": "2D Mesh Grid Search", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_optimization_source_sink_energy_balance", "label": "Source-Sink Energy Balance (Q_source_req)", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_heat_pump_optimization_zero_crossing_detection", "label": "Zero-Crossing Exact Operating Point Detection", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Available minus required waste heat is tracked by sign; a sign change between adjacent grid points brackets an exact match, and linear interpolation on the fraction recovers source temperature and COP without refining the whole mesh. A near-zero denominator is skipped to avoid division blow-up."}, {"id": "docs_heat_pump_optimization_source_limited_integration", "label": "Source-Limited Heat Pump Integration", "file_type": "rationale", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When waste heat cannot cover full demand there is no zero crossing, so the algorithm instead reports points where the pump absorbs all available waste heat, capping deliverable sink duty at demand. Candidates are kept only above a 1% coverage threshold to suppress meaningless near-zero options."}, {"id": "docs_heat_pump_optimization_output_ranking", "label": "Candidate Ranking and Output Summary", "file_type": "concept", "source_file": "docs/heat_pump_optimization.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Results are ranked by COP, condenser output and electrical input, and returned as best_cop_points, source_limited_points, refrigerant_type and diagnostics (mesh points evaluated, points skipped outside envelope, zero-crossing solutions) so users can see why candidates were rejected."}], "edges": [{"source": "docs_heat_pump_optimization_heat_pump_optimization", "target": "docs_heat_pump_integration_heat_pump_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_optimization.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_optimization_heat_pump_optimization", "target": "docs_refrigerant_limits_refrigerant_operating_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_optimization.md", "source_location": "Refrigerant Operating Limits link", "weight": 1.0}, {"source": "docs_heat_pump_optimization_heat_pump_optimization", "target": "docs_heat_pump_optimization_predictive_ml_cop_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/heat_pump_optimization.md", "source_location": null, "weight": 1.0}, {"source": "docs_heat_pump_optimization_predictive_ml_cop_model", "target": "docs_heat_pump_optimization_refrigerant_data_schema", "relation": "shares_data_with", "confidence": "EXTR