# Copy to .env (kept out of git) and set per machine. docker compose reads it.

# Public address the app is served under. A domain (e.g. app.example.org) gets
# a TLS certificate automatically; leave unset to serve http://localhost.
SITE_ADDRESS=

# AI access: Connect AI on the page and the MCP server at /mcp. 0 turns it off,
# the rest of the app stays as it is.
AI_ENABLED=1
